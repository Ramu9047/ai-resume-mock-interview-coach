# ─── AI Resume & Mock Interview Coach Environment Configuration ────────────────

# Groq API Key (Required for AI Analysis, ATS Scoring, Field Improvement, and Mock Interview evaluation)
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Admin Analytics Secret Credential (Required to unlock the Admin Analytics Dashboard at /admin)
ADMIN_ANALYTICS_SECRET=your_admin_secret_key_here

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/resume_coach

# Backend Server Port (Optional, defaults to 8080)
PORT=8080
